{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": [
        "airbnb-base"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2018,
        "sourceType": "module"
    },
    "rules": {
        "indent": [
            "error",
            4
        ],
        "linebreak-style": "off",
        "quotes": "off",
        "comma-dangle": "off",
        "no-param-reassign": "off",
        "no-alert": "off",
        "prefer-destructuring": "off",
        "no-unneeded-ternary": "off"
    }
}
